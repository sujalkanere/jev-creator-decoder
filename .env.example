# npm run setup fills this in for you. Never commit .env.
YOUTUBE_API_KEY=paste-your-youtube-data-api-v3-key

# Required. Jev runs on TypeSafe's own API with this key, with Cloudflare Workers AI as the
# fallback. Add $5 of credit in your TypeSafe dashboard before you can create a key.
TYPESAFE_API_KEY=paste-your-typesafe-api-key

# Created by npm run setup. Encrypts API keys you save from the dashboard's Settings page.
# Keep it: a new value makes keys saved in Settings unreadable.
# SETTINGS_SECRET=

# Optional. Model Race challengers (you can also add these in the dashboard's Settings).: each model appears in the race once its key is set.
# ANTHROPIC_API_KEY=paste-your-anthropic-api-key
# OPENAI_API_KEY=paste-your-openai-api-key
# OPENROUTER_API_KEY=paste-your-openrouter-api-key

# Optional model overrides (defaults: claude-opus-5, gpt-5-mini, google/gemini-2.5-flash-lite).
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# OPENROUTER_MODEL=
